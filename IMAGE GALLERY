<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Lumière — Image Gallery</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="style.css" />
</head>
<body>

  <!-- ─── HEADER ─── -->
  <header class="site-header">
    <div class="header-inner">
      <div class="logo">
        <span class="logo-mark">✦</span>
        <span class="logo-text">Lumière</span>
      </div>
      <nav class="header-nav">
        <a href="#gallery">Gallery</a>
        <a href="#about">About</a>
      </nav>
    </div>
  </header>

  <!-- ─── HERO ─── -->
  <section class="hero">
    <div class="hero-content">
      <p class="hero-eyebrow">A curated collection</p>
      <h1 class="hero-title">The World Through<br /><em>Light &amp; Lens</em></h1>
      <p class="hero-sub">Photography, nature, architecture, and beyond — explore the world one frame at a time.</p>
      <a href="#gallery" class="hero-cta">Explore Gallery</a>
    </div>
    <div class="hero-stats">
      <div class="stat"><span class="stat-num">48</span><span class="stat-label">Photographs</span></div>
      <div class="stat-divider"></div>
      <div class="stat"><span class="stat-num">6</span><span class="stat-label">Categories</span></div>
      <div class="stat-divider"></div>
      <div class="stat"><span class="stat-num">∞</span><span class="stat-label">Stories</span></div>
    </div>
  </section>

  <!-- ─── GALLERY SECTION ─── -->
  <section class="gallery-section" id="gallery">
    <div class="section-header">
      <h2 class="section-title">Gallery</h2>
      <p class="section-sub">Click any image to view full size</p>
    </div>

    <!-- Filter Pills -->
    <div class="filter-bar" role="tablist" aria-label="Filter by category">
      <button class="filter-btn active" data-filter="all" role="tab" aria-selected="true">All</button>
      <button class="filter-btn" data-filter="nature" role="tab" aria-selected="false">Nature</button>
      <button class="filter-btn" data-filter="architecture" role="tab" aria-selected="false">Architecture</button>
      <button class="filter-btn" data-filter="travel" role="tab" aria-selected="false">Travel</button>
      <button class="filter-btn" data-filter="abstract" role="tab" aria-selected="false">Abstract</button>
      <button class="filter-btn" data-filter="portrait" role="tab" aria-selected="false">Portrait</button>
      <button class="filter-btn" data-filter="cityscape" role="tab" aria-selected="false">Cityscape</button>
    </div>

    <!-- Grid -->
    <div class="gallery-grid" id="galleryGrid">
      <!-- Cards injected by JS -->
    </div>

    <!-- Load more -->
    <div class="load-more-wrap">
      <button class="load-more-btn" id="loadMoreBtn">Load More</button>
    </div>
  </section>

  <!-- ─── LIGHTBOX ─── -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Image viewer" hidden>
    <div class="lightbox-overlay" id="lbOverlay"></div>
    <div class="lightbox-container">
      <button class="lb-close" id="lbClose" aria-label="Close">✕</button>
      <button class="lb-nav lb-prev" id="lbPrev" aria-label="Previous image">&#8592;</button>
      <div class="lb-image-wrap">
        <img class="lb-img" id="lbImg" src="" alt="" />
        <div class="lb-spinner" id="lbSpinner"></div>
      </div>
      <button class="lb-nav lb-next" id="lbNext" aria-label="Next image">&#8594;</button>
      <div class="lb-meta">
        <div class="lb-meta-left">
          <p class="lb-title" id="lbTitle"></p>
          <p class="lb-cat" id="lbCat"></p>
        </div>
        <div class="lb-counter" id="lbCounter"></div>
      </div>
      <div class="lb-thumbnails" id="lbThumbnails"></div>
    </div>
  </div>

  <!-- ─── FOOTER ─── -->
  <footer class="site-footer" id="about">
    <div class="footer-inner">
      <div class="footer-brand">
        <span class="logo-mark">✦</span>
        <span class="logo-text">Lumière</span>
      </div>
      <p class="footer-copy">A demonstration of HTML, CSS &amp; JavaScript craftsmanship.</p>
      <p class="footer-copy small">Images sourced from <a href="https://picsum.photos" target="_blank" rel="noopener">picsum.photos</a> (Lorem Picsum)</p>
    </div>
  </footer>


/* ═══════════════════════════════════════════════
   LUMIÈRE IMAGE GALLERY — style.css
   Design tokens → Components → Layouts → Media
   ═══════════════════════════════════════════════ */

/* ─── TOKENS ─── */
:root {
  --navy:      #0D1B2A;
  --navy-mid:  #1A2E42;
  --navy-light:#243B55;
  --teal:      #00D4FF;
  --teal-dim:  rgba(0,212,255,.12);
  --gold:      #FFD166;
  --white:     #F8FAFC;
  --white-dim: rgba(248,250,252,.08);
  --text:      #E2E8F0;
  --text-muted:#94A3B8;
  --radius-sm: 8px;
  --radius-md: 14px;
  --radius-lg: 22px;
  --shadow-card: 0 4px 24px rgba(0,0,0,.45);
  --shadow-hover: 0 12px 40px rgba(0,212,255,.18);
  --transition: 0.35s cubic-bezier(0.4,0,0.2,1);
  --font-display: 'Playfair Display', Georgia, serif;
  --font-body:    'Inter', system-ui, sans-serif;
}

/* ─── RESET & BASE ─── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

html {
  scroll-behavior: smooth;
  font-size: 16px;
}

body {
  background: var(--navy);
  color: var(--text);
  font-family: var(--font-body);
  line-height: 1.6;
  overflow-x: hidden;
}

img { display: block; max-width: 100%; }
a { color: var(--teal); text-decoration: none; transition: opacity var(--transition); }
a:hover { opacity: 0.75; }
button { cursor: pointer; border: none; background: none; font-family: inherit; }

/* ─── SCROLLBAR ─── */
::-webkit-scrollbar { width: 6px; }
::-webkit-scrollbar-track { background: var(--navy); }
::-webkit-scrollbar-thumb { background: var(--navy-light); border-radius: 4px; }

/* ══════════════════════════════════
   HEADER
══════════════════════════════════ */
.site-header {
  position: fixed;
  top: 0; left: 0; right: 0;
  z-index: 100;
  background: rgba(13,27,42,.82);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(0,212,255,.1);
}

.header-inner {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 2rem;
  height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.logo {
  display: flex;
  align-items: center;
  gap: 8px;
}

.logo-mark {
  color: var(--teal);
  font-size: 1.25rem;
}

.logo-text {
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--white);
  letter-spacing: .02em;
}

.header-nav {
  display: flex;
  gap: 2rem;
}

.header-nav a {
  color: var(--text-muted);
  font-size: .875rem;
  font-weight: 500;
  letter-spacing: .05em;
  text-transform: uppercase;
  transition: color var(--transition);
}
.header-nav a:hover { color: var(--teal); opacity: 1; }

/* ══════════════════════════════════
   HERO
══════════════════════════════════ */
.hero {
  min-height: 100svh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  padding: 120px 2rem 6rem;
  position: relative;
  overflow: hidden;
}

/* Animated radial glow background */
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    radial-gradient(ellipse 60% 50% at 50% 40%, rgba(0,212,255,.08) 0%, transparent 70%),
    radial-gradient(ellipse 40% 30% at 80% 70%, rgba(255,209,102,.04) 0%, transparent 60%);
  pointer-events: none;
}

/* Subtle grid lines */
.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(0,212,255,.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,212,255,.04) 1px, transparent 1px);
  background-size: 60px 60px;
  pointer-events: none;
}

.hero-content {
  position: relative;
  z-index: 1;
  max-width: 720px;
}

.hero-eyebrow {
  font-size: .8rem;
  font-weight: 500;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--teal);
  margin-bottom: 1rem;
}

.hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.6rem, 6vw, 5rem);
  font-weight: 700;
  line-height: 1.1;
  color: var(--white);
  margin-bottom: 1.25rem;
}

.hero-title em {
  font-style: italic;
  color: var(--teal);
}

.hero-sub {
  font-size: clamp(.95rem, 2vw, 1.15rem);
  color: var(--text-muted);
  max-width: 480px;
  margin: 0 auto 2.5rem;
  line-height: 1.7;
}

.hero-cta {
  display: inline-flex;
  align-items: center;
  gap: .5rem;
  padding: .85rem 2.25rem;
  background: var(--teal);
  color: var(--navy);
  font-weight: 600;
  font-size: .95rem;
  border-radius: 50px;
  letter-spacing: .03em;
  transition: transform var(--transition), box-shadow var(--transition), background var(--transition);
}

.hero-cta:hover {
  opacity: 1;
  background: #fff;
  transform: translateY(-2px);
  box-shadow: 0 10px 40px rgba(0,212,255,.3);
}

.hero-stats {
  display: flex;
  align-items: center;
  gap: 2rem;
  margin-top: 4rem;
  position: relative;
  z-index: 1;
}

.stat { text-align: center; }
.stat-num {
  display: block;
  font-family: var(--font-display);
  font-size: 2.4rem;
  font-weight: 700;
  color: var(--white);
  line-height: 1;
}
.stat-label {
  display: block;
  font-size: .75rem;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-muted);
  margin-top: .3rem;
}
.stat-divider {
  width: 1px;
  height: 48px;
  background: rgba(0,212,255,.2);
}

/* ══════════════════════════════════
   GALLERY SECTION
══════════════════════════════════ */
.gallery-section {
  max-width: 1340px;
  margin: 0 auto;
  padding: 5rem 1.5rem 6rem;
}

.section-header {
  text-align: center;
  margin-bottom: 2.5rem;
}

.section-title {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 4vw, 3rem);
  font-weight: 700;
  color: var(--white);
  position: relative;
  display: inline-block;
}

.section-title::after {
  content: '';
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  bottom: -10px;
  width: 40px;
  height: 3px;
  background: var(--teal);
  border-radius: 2px;
}

.section-sub {
  margin-top: 1.2rem;
  color: var(--text-muted);
  font-size: .9rem;
}

/* ─── FILTER BAR ─── */
.filter-bar {
  display: flex;
  flex-wrap: wrap;
  gap: .6rem;
  justify-content: center;
  margin-bottom: 3rem;
}

.filter-btn {
  padding: .5rem 1.3rem;
  border: 1.5px solid rgba(0,212,255,.25);
  border-radius: 50px;
  color: var(--text-muted);
  font-size: .83rem;
  font-weight: 500;
  letter-spacing: .05em;
  transition: all var(--transition);
  background: transparent;
}

.filter-btn:hover {
  color: var(--teal);
  border-color: var(--teal);
  background: var(--teal-dim);
}

.filter-btn.active {
  background: var(--teal);
  border-color: var(--teal);
  color: var(--navy);
  font-weight: 600;
}

/* ─── GALLERY GRID ─── */
.gallery-grid {
  columns: 4;
  column-gap: 1.1rem;
  orphans: 1;
  widows: 1;
}

/* ─── GALLERY CARD ─── */
.gallery-card {
  break-inside: avoid;
  margin-bottom: 1.1rem;
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
  cursor: pointer;
  background: var(--navy-mid);
  transition: transform var(--transition), box-shadow var(--transition);
}

.gallery-card:hover {
  transform: translateY(-4px) scale(1.01);
  box-shadow: var(--shadow-hover);
  z-index: 2;
}

.gallery-card.hidden {
  display: none;
}

.gallery-card.fade-out {
  animation: fadeOut .2s ease forwards;
}

.gallery-card.fade-in {
  animation: fadeIn .35s ease forwards;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(16px) scale(.98); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes fadeOut {
  from { opacity: 1; }
  to   { opacity: 0; }
}

.card-img-wrap {
  overflow: hidden;
  position: relative;
  aspect-ratio: auto;
  line-height: 0;
}

.card-img {
  width: 100%;
  height: auto;
  object-fit: cover;
  transition: transform .55s cubic-bezier(.25,.46,.45,.94);
  filter: brightness(.92);
}

.gallery-card:hover .card-img {
  transform: scale(1.07);
  filter: brightness(1);
}

/* Overlay on hover */
.card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(13,27,42,.88) 0%,
    rgba(13,27,42,.2) 50%,
    transparent 100%
  );
  opacity: 0;
  transition: opacity var(--transition);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 1.1rem;
}

.gallery-card:hover .card-overlay {
  opacity: 1;
}

.card-title {
  font-family: var(--font-display);
  font-size: .95rem;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.card-cat-badge {
  display: inline-block;
  margin-top: .35rem;
  padding: .2rem .65rem;
  background: var(--teal);
  color: var(--navy);
  font-size: .72rem;
  font-weight: 600;
  border-radius: 50px;
  letter-spacing: .06em;
  text-transform: uppercase;
  width: fit-content;
}

/* Expand icon */
.card-expand {
  position: absolute;
  top: .7rem;
  right: .7rem;
  width: 34px;
  height: 34px;
  background: rgba(0,0,0,.55);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0;
  transform: scale(.8);
  transition: all var(--transition);
  color: #fff;
  font-size: 1rem;
}
.gallery-card:hover .card-expand {
  opacity: 1;
  transform: scale(1);
}

/* ─── LOAD MORE ─── */
.load-more-wrap {
  text-align: center;
  margin-top: 3rem;
}

.load-more-btn {
  padding: .85rem 2.5rem;
  border: 1.5px solid rgba(0,212,255,.35);
  border-radius: 50px;
  color: var(--teal);
  font-size: .9rem;
  font-weight: 500;
  letter-spacing: .06em;
  transition: all var(--transition);
}

.load-more-btn:hover {
  background: var(--teal-dim);
  border-color: var(--teal);
}

.load-more-btn:disabled {
  opacity: .35;
  cursor: not-allowed;
}

/* ══════════════════════════════════
   LIGHTBOX
══════════════════════════════════ */
.lightbox {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 1rem;
}

.lightbox[hidden] { display: none; }

.lightbox-overlay {
  position: absolute;
  inset: 0;
  background: rgba(5,10,18,.94);
  cursor: pointer;
  backdrop-filter: blur(4px);
}

.lightbox-container {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 960px;
  animation: lbIn .3s ease;
}

@keyframes lbIn {
  from { opacity: 0; transform: scale(.96); }
  to   { opacity: 1; transform: scale(1); }
}

/* Close */
.lb-close {
  position: absolute;
  top: -14px;
  right: -14px;
  width: 42px;
  height: 42px;
  background: rgba(255,255,255,.1);
  border: 1.5px solid rgba(255,255,255,.15);
  border-radius: 50%;
  color: #fff;
  font-size: 1rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition);
  z-index: 10;
}
.lb-close:hover {
  background: rgba(255,80,80,.7);
  border-color: transparent;
}

/* Nav arrows */
.lb-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 52px;
  height: 52px;
  background: rgba(0,0,0,.55);
  border: 1.5px solid rgba(0,212,255,.3);
  border-radius: 50%;
  color: var(--teal);
  font-size: 1.3rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all var(--transition);
  z-index: 10;
}

.lb-prev { left: -68px; }
.lb-next { right: -68px; }

.lb-nav:hover {
  background: var(--teal);
  color: var(--navy);
  border-color: var(--teal);
  transform: translateY(-50%) scale(1.08);
}

.lb-nav:disabled {
  opacity: .3;
  cursor: not-allowed;
  transform: translateY(-50%);
}

/* Image wrap */
.lb-image-wrap {
  width: 100%;
  background: var(--navy-mid);
  border-radius: var(--radius-lg);
  overflow: hidden;
  position: relative;
  box-shadow: 0 24px 80px rgba(0,0,0,.7);
  border: 1px solid rgba(0,212,255,.12);
  min-height: 200px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.lb-img {
  width: 100%;
  max-height: 72vh;
  object-fit: contain;
  display: block;
  transition: opacity .25s ease;
}

.lb-img.loading { opacity: 0; }

/* Spinner */
.lb-spinner {
  position: absolute;
  width: 36px;
  height: 36px;
  border: 3px solid rgba(0,212,255,.2);
  border-top-color: var(--teal);
  border-radius: 50%;
  animation: spin .7s linear infinite;
  display: none;
}
.lb-spinner.visible { display: block; }

@keyframes spin { to { transform: rotate(360deg); } }

/* Meta */
.lb-meta {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding: 1rem .25rem .5rem;
}

.lb-title {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  color: var(--white);
}

.lb-cat {
  font-size: .78rem;
  font-weight: 500;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--teal);
  margin-top: .2rem;
}

.lb-counter {
  font-size: .8rem;
  color: var(--text-muted);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

/* Thumbnails strip */
.lb-thumbnails {
  display: flex;
  gap: .45rem;
  margin-top: .75rem;
  overflow-x: auto;
  max-width: 100%;
  padding-bottom: .25rem;
  scrollbar-width: thin;
  scrollbar-color: var(--navy-light) transparent;
}

.lb-thumb {
  width: 56px;
  height: 40px;
  object-fit: cover;
  border-radius: 6px;
  cursor: pointer;
  opacity: .45;
  border: 2px solid transparent;
  flex-shrink: 0;
  transition: all .2s ease;
}

.lb-thumb.active {
  opacity: 1;
  border-color: var(--teal);
}

.lb-thumb:hover { opacity: .8; }

/* ══════════════════════════════════
   FOOTER
══════════════════════════════════ */
.site-footer {
  border-top: 1px solid rgba(0,212,255,.1);
  padding: 3rem 2rem;
  text-align: center;
}

.footer-inner {
  max-width: 600px;
  margin: 0 auto;
}

.footer-brand {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  margin-bottom: .75rem;
}

.footer-copy {
  color: var(--text-muted);
  font-size: .85rem;
  line-height: 1.6;
}

.footer-copy.small {
  font-size: .78rem;
  margin-top: .4rem;
}

/* ══════════════════════════════════
   RESPONSIVE
══════════════════════════════════ */
@media (max-width: 1100px) {
  .gallery-grid { columns: 3; }
  .lb-prev { left: -56px; }
  .lb-next { right: -56px; }
}

@media (max-width: 768px) {
  .gallery-grid { columns: 2; }
  .hero-stats { gap: 1.25rem; }
  .lb-nav {
    width: 40px; height: 40px;
    font-size: 1rem;
  }
  .lb-prev { left: -48px; }
  .lb-next { right: -48px; }
  .header-nav { display: none; }
}

@media (max-width: 480px) {
  .gallery-grid { columns: 1; }
  .lb-prev { left: 4px; top: auto; bottom: 60px; transform: none; }
  .lb-next { right: 4px; top: auto; bottom: 60px; transform: none; }
  .lb-nav:hover { transform: scale(1.08); }
  .hero-stats { flex-direction: column; gap: 1.5rem; }
  .stat-divider { width: 40px; height: 1px; }
}

/* ─── REDUCED MOTION ─── */
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
}

/**
 * LUMIÈRE — gallery.js
 * Full image gallery with masonry grid, category filters,
 * lightbox, prev/next navigation, thumbnails, and keyboard support.
 */

