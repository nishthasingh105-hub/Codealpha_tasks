<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Responsive Image Gallery</title>
  <link rel="stylesheet" href="styles.css" />
</head>
<body>
  <main class="container">
    <h1>Image Gallery</h1>

    <div class="controls">
      <div class="filter-buttons" role="tablist" aria-label="Image categories">
        <button class="filter-btn active" data-filter="all" aria-pressed="true">All</button>
        <button class="filter-btn" data-filter="nature">Nature</button>
        <button class="filter-btn" data-filter="architecture">Architecture</button>
        <button class="filter-btn" data-filter="people">People</button>
      </div>
    </div>

    <section id="gallery" class="gallery" aria-label="Image gallery">
      <!-- Each figure has data-category and data-index -->
      <figure class="gallery-item" data-category="nature" tabindex="0">
        <img src="https://picsum.photos/seed/nature1/600/400" alt="Nature 1" loading="lazy">
        <figcaption>Nature 1</figcaption>
      </figure>

      <figure class="gallery-item" data-category="architecture" tabindex="0">
        <img src="https://picsum.photos/seed/arch1/600/400" alt="Architecture 1" loading="lazy">
        <figcaption>Architecture 1</figcaption>
      </figure>

      <figure class="gallery-item" data-category="people" tabindex="0">
        <img src="https://picsum.photos/seed/people1/600/400" alt="People 1" loading="lazy">
        <figcaption>People 1</figcaption>
      </figure>

      <figure class="gallery-item" data-category="nature" tabindex="0">
        <img src="https://picsum.photos/seed/nature2/600/400" alt="Nature 2" loading="lazy">
        <figcaption>Nature 2</figcaption>
      </figure>

      <figure class="gallery-item" data-category="architecture" tabindex="0">
        <img src="https://picsum.photos/seed/arch2/600/400" alt="Architecture 2" loading="lazy">
        <figcaption>Architecture 2</figcaption>
      </figure>

      <figure class="gallery-item" data-category="people" tabindex="0">
        <img src="https://picsum.photos/seed/people2/600/400" alt="People 2" loading="lazy">
        <figcaption>People 2</figcaption>
      </figure>

      <figure class="gallery-item" data-category="nature" tabindex="0">
        <img src="https://picsum.photos/seed/nature3/600/400" alt="Nature 3" loading="lazy">
        <figcaption>Nature 3</figcaption>
      </figure>

      <figure class="gallery-item" data-category="architecture" tabindex="0">
        <img src="https://picsum.photos/seed/arch3/600/400" alt="Architecture 3" loading="lazy">
        <figcaption>Architecture 3</figcaption>
      </figure>

      <figure class="gallery-item" data-category="people" tabindex="0">
        <img src="https://picsum.photos/seed/people3/600/400" alt="People 3" loading="lazy">
        <figcaption>People 3</figcaption>
      </figure>
    </section>
  </main>

  <!-- Lightbox / modal -->
  <div id="lightbox" class="lightbox" aria-hidden="true" role="dialog" aria-label="Image viewer">
    <button id="lb-close" class="lb-close" aria-label="Close (Esc)">&times;</button>
    <button id="lb-prev" class="lb-nav lb-prev" aria-label="Previous image">&#10094;</button>
    <div class="lb-content">
      <img id="lb-image" src="" alt="">
      <p id="lb-caption" class="lb-caption"></p>
    </div>
    <button id="lb-next" class="lb-nav lb-next" aria-label="Next image">&#10095;</button>
  </div>

  <script src="script.js"></script>
</body>
</html>

:root{
  --gap: 16px;
  --bg: #fafafa;
  --card: #fff;
  --accent: #1f7aec;
  --text: #222;
  --shadow: 0 6px 18px rgba(0,0,0,0.08);
}

*{box-sizing:border-box}
body{
  margin:0;
  font-family: Inter, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  background:var(--bg);
  color:var(--text);
  line-height:1.3;
  padding:32px;
}

.container{
  max-width:1200px;
  margin:0 auto;
}

h1{
  margin:0 0 16px 0;
  font-size:1.5rem;
}

/* Filter buttons */
.controls{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:16px;
}

.filter-buttons{
  display:flex;
  gap:8px;
}

.filter-btn{
  background:transparent;
  border:1px solid #ddd;
  padding:8px 12px;
  border-radius:8px;
  cursor:pointer;
  transition:all .18s ease;
  font-size:0.95rem;
}
.filter-btn:hover{ transform:translateY(-2px); box-shadow:var(--shadow) }
.filter-btn.active{
  background:var(--accent);
  color:white;
  border-color:var(--accent);
}

/* Gallery grid */
.gallery{
  display:grid;
  gap:var(--gap);
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  align-items:start;
}

.gallery-item{
  background:var(--card);
  border-radius:10px;
  overflow:hidden;
  box-shadow:var(--shadow);
  cursor:zoom-in;
  transition:transform .22s ease, box-shadow .22s ease;
  display:flex;
  flex-direction:column;
  min-height:140px;
  user-select:none;
}
.gallery-item:hover{
  transform:translateY(-6px) scale(1.01);
  box-shadow:0 14px 30px rgba(0,0,0,0.12);
}
.gallery-item img{
  display:block;
  width:100%;
  height:170px;
  object-fit:cover;
  transition:transform .3s ease, filter .3s ease;
}
.gallery-item:hover img{ transform:scale(1.04) saturate(1.05) }

/* caption */
.gallery-item figcaption{
  padding:10px 12px;
  font-size:0.95rem;
  color:#333;
  border-top:1px solid #f0f0f0;
  background:linear-gradient(180deg, rgba(255,255,255,0), rgba(255,255,255,0.02));
}

/* hide filtered items gracefully */
.gallery-item.hidden{
  opacity:0;
  transform:scale(.98);
  pointer-events:none;
  height:0;
  margin:0;
  padding:0;
  transition:opacity .28s ease, transform .28s ease, height .28s ease;
}

/* Lightbox */
.lightbox{
  position:fixed;
  inset:0;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(0,0,0,0.6);
  z-index:9999;
  opacity:0;
  visibility:hidden;
  transition:opacity .2s ease;
  padding:24px;
}
.lightbox[aria-hidden="false"]{
  opacity:1;
  visibility:visible;
}
.lb-content{
  max-width:1100px;
  width:100%;
  max-height:90vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
}
.lb-content img{
  width:100%;
  max-height:78vh;
  object-fit:contain;
  border-radius:8px;
  box-shadow:0 12px 40px rgba(0,0,0,0.4);
  transition:transform .18s ease;
}
.lb-caption{
  color:#fff;
  text-align:center;
  font-size:0.95rem;
  margin:0;
}

/* nav buttons */
.lb-nav{
  position:fixed;
  top:50%;
  transform:translateY(-50%);
  background:transparent;
  color:white;
  border:none;
  font-size:2rem;
  padding:8px 12px;
  cursor:pointer;
  opacity:.9;
}
.lb-prev{ left:20px }
.lb-next{ right:20px }

.lb-close{
  position:fixed;
  top:16px;
  right:20px;
  background:transparent;
  color:white;
  border:none;
  font-size:2.2rem;
  cursor:pointer;
  padding:6px 8px;
}

/* responsiveness tweaks */
@media (max-width:700px){
  .gallery-item img{ height:140px }
  .lb-nav{ font-size:1.6rem }
  .lb-close{ font-size:1.6rem }
}

@media (max-width:420px){
  body{ padding:16px }
  .gallery{ grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap:12px }
  .gallery-item img{ height:120px }
}

// Script for gallery interactions: lightbox, navigation, keyboard, filtering
document.addEventListener('DOMContentLoaded', () => {
  const gallery = document.getElementById('gallery');
  const items = Array.from(gallery.querySelectorAll('.gallery-item'));
  const lightbox = document.getElementById('lightbox');
  const lbImage = document.getElementById('lb-image');
  const lbCaption = document.getElementById('lb-caption');
  const btnClose = document.getElementById('lb-close');
  const btnNext = document.getElementById('lb-next');
  const btnPrev = document.getElementById('lb-prev');
  const filterBtns = Array.from(document.querySelectorAll('.filter-btn'));

  let currentIndex = 0;
  let visibleItems = items.slice(); // items that aren't filtered out

  // assign an index to each item
  items.forEach((el, i) => el.dataset.index = i);

  function openLightbox(index) {
    const fig = visibleItems[index];
    if (!fig) return;
    const img = fig.querySelector('img');
    lbImage.src = img.src.replace('/600/400', '/1200/800'); // try larger if using picsum pattern
    lbImage.alt = img.alt || '';
    lbCaption.textContent = fig.querySelector('figcaption')?.textContent || '';
    lightbox.setAttribute('aria-hidden', 'false');
    currentIndex = index;
    // focus for accessibility
    btnClose.focus();
  }

  function closeLightbox() {
    lightbox.setAttribute('aria-hidden', 'true');
    lbImage.src = '';
  }

  function showNext() {
    if (visibleItems.length === 0) return;
    currentIndex = (currentIndex + 1) % visibleItems.length;
    openLightbox(currentIndex);
  }

  function showPrev() {
    if (visibleItems.length === 0) return;
    currentIndex = (currentIndex - 1 + visibleItems.length) % visibleItems.length;
    openLightbox(currentIndex);
  }

  // thumbnail click / keyboard open
  function onThumbClick(e) {
    const fig = e.currentTarget;
    const indexInAll = parseInt(fig.dataset.index, 10);
    // find position in visibleItems
    const indexInVisible = visibleItems.findIndex(v => parseInt(v.dataset.index, 10) === indexInAll);
    if (indexInVisible >= 0) openLightbox(indexInVisible);
  }

  items.forEach(item => {
    item.addEventListener('click', onThumbClick);
    item.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        onThumbClick.call(item, e);
      }
    });
  });

  // lightbox controls
  btnClose.addEventListener('click', closeLightbox);
  btnNext.addEventListener('click', showNext);
  btnPrev.addEventListener('click', showPrev);

  // close clicking outside the image
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  // keyboard navigation
  document.addEventListener('keydown', (e) => {
    if (lightbox.getAttribute('aria-hidden') === 'false') {
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
      if (e.key === 'Escape') closeLightbox();
    }
  });

  // Filters
  function applyFilter(category) {
    if (category === 'all') {
      items.forEach(i => i.classList.remove('hidden'));
    } else {
      items.forEach(i => {
        if (i.dataset.category === category) i.classList.remove('hidden');
        else i.classList.add('hidden');
      });
    }
    // re-compute visibleItems in DOM order
    visibleItems = Array.from(gallery.querySelectorAll('.gallery-item:not(.hidden)'));
  }

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => { b.classList.remove('active'); b.setAttribute('aria-pressed','false') });
      btn.classList.add('active');
      btn.setAttribute('aria-pressed','true');
      const filter = btn.dataset.filter;
      applyFilter(filter);
    });
  });

  // Init: no filter (show all)
  applyFilter('all');
});